# Primary LLM provider: DeepSeek through its Anthropic-compatible API.
# Put your DeepSeek API key in ANTHROPIC_API_KEY; the app's client uses this name.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
COPYWRITER_MODEL=deepseek-flash
COPYWRITER_MAX_OUTPUT_TOKENS=393216

# IMA credentials
IMA_CLIENT_ID=
IMA_API_KEY=
